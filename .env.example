# Required - your OpenAI key. Paste it on its own, no quotes, no spaces.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - which model to use. Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional - an access code so only you can open the site.
# SITE_PASSWORD=my-secret-code

# Added automatically when you attach a Blob Store on Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
